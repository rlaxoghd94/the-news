{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1080px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "paper",
					"name": "종이",
					"color": "#f6f7f9"
				},
				{
					"slug": "ink",
					"name": "잉크",
					"color": "#1b2333"
				},
				{
					"slug": "muted",
					"name": "보조 글자",
					"color": "#5b6475"
				},
				{
					"slug": "rule",
					"name": "구분선",
					"color": "#d9dde4"
				},
				{
					"slug": "link",
					"name": "링크",
					"color": "#2f5d8a"
				},
				{
					"slug": "box",
					"name": "상자",
					"color": "#eaedf2"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "IBM Plex Sans KR",
					"fontFamily": "\"IBM Plex Sans KR\", \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "작게",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "보통",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "크게",
					"size": "1.3rem",
					"fluid": {
						"min": "1.15rem",
						"max": "1.3rem"
					}
				},
				{
					"slug": "x-large",
					"name": "아주 크게",
					"size": "2.2rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2.2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "제목",
					"size": "2.9rem",
					"fluid": {
						"min": "2rem",
						"max": "2.9rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "2",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "3",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "4",
					"size": "2.25rem"
				},
				{
					"slug": "60",
					"name": "5",
					"size": "3rem"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": {
				"left": "max(16px, 4vw)",
				"right": "max(16px, 4vw)"
			},
			"blockGap": "1.2em"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.8"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"lineHeight": "1.35",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.28"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "1.45rem"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--paper)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"radius": "4px"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.8125rem"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"textWrap": "balance"
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--muted)"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--ink)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "20px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"fontSize": "1.15rem"
				}
			},
			"core/table": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.95rem"
				}
			},
			"core/search": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.9375rem"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "머리글",
			"area": "header"
		},
		{
			"name": "header-narrow",
			"title": "머리글 (글 상세)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "바닥글",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "사이드바",
			"area": "uncategorized"
		}
	],
	"customTemplates": []
}
