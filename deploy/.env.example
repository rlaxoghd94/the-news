# PUBLIC TEST EXAMPLES ONLY: never use these passwords for operations.
# For operations, create a separate ignored deploy/.env with unique secrets,
# restrict its permissions, and do not paste rendered config into logs/cards.
MARIADB_DATABASE=the_news
MARIADB_USER=the_news
MARIADB_PASSWORD=EXAMPLE_ONLY_NOT_FOR_PRODUCTION_DB
MARIADB_ROOT_PASSWORD=EXAMPLE_ONLY_NOT_FOR_PRODUCTION_ROOT
# Local testing default; binding remains 127.0.0.1 in compose.yaml.
WORDPRESS_PORT=8080
